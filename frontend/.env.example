# Copy this file to .env (local dev) or set these as Environment Variables
# in the Vercel project settings (Production/Preview/Development) — never
# commit a real .env file.

# Base URL of the Max Pizza Hub backend API. Must be reachable over HTTPS in
# production; the backend's CORS_ORIGIN must include this site's deployed
# origin (e.g. https://your-site.vercel.app).
VITE_API_BASE_URL=http://localhost:4000
