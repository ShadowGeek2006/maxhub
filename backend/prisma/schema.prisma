// Max Pizza Hub — Backend Data Model
//
// Scope: persistent order management + admin dashboard API only.
// No menu/inventory tables — menu items still live in the frontend.
// Order items are stored as a snapshot (name/price/veg flag) at order time,
// so later menu edits never change historical orders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for MVP simplicity — zero external services to run.
  // Swap to "postgresql" + a DATABASE_URL when moving to production
  // without touching any application code.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite has no native enum type, and Prisma's `enum` keyword isn't
// supported on the sqlite connector — status/orderType are plain Strings
// here, constrained to a fixed set of values by the zod schemas in
// src/validators/ instead of by the DB schema. (If this project ever
// moves to Postgres, these could become real Prisma enums at that point.)
model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  status          String      @default("PENDING") // PENDING | PREPARING | READY | COMPLETED | CANCELLED
  orderType       String      // PICKUP | DELIVERY
  customerName    String
  customerPhone   String
  deliveryAddress String?
  notes           String?
  subtotal        Float
  total           Float
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  name       String
  quantity   Int
  unitPrice  Float
  isVeg      Boolean @default(true)
  subtotal   Float

  @@index([orderId])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
