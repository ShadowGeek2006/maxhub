# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

# SQLite for local/dev. For production, point this at a managed Postgres
# instance instead (e.g. postgresql://user:pass@host:5432/dbname) and
# change the "provider" in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Long, random secret used to sign admin JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=92838237489200011232136879
JWT_EXPIRES_IN=12h

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173
